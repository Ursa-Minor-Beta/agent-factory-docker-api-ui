# syntax=docker/dockerfile:1
FROM node:26-alpine AS src

ARG UI_VERSION

# Fetch the repository (re-fetched only when the ref points to a new commit)
ADD https://github.com/Ursa-Minor-Beta/agent-factory-ui.git#${UI_VERSION} /src

FROM node:26-alpine AS builder

ARG VITE_API_URL
ARG VITE_APP_NAME

WORKDIR /app

# Install dependencies (cached until package*.json changes)
COPY --from=src /src/package*.json ./
RUN --mount=type=cache,target=/root/.npm npm ci

COPY --from=src /src ./

ENV VITE_API_URL=$VITE_API_URL
ENV VITE_APP_NAME=$VITE_APP_NAME

RUN npm run build

# Production stage
FROM nginx:alpine

# Copy nginx config from the repo
COPY --from=src /src/nginx.conf /etc/nginx/conf.d/default.conf

# Copy built assets
COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
