# =============================================================================
# 1. REQUIRED - set all of these before the first deploy
# =============================================================================

# --- Public URLs -------------------------------------------------------------
# Local:      http://localhost:8080 (UI) / http://localhost:3000 (API)
# Production: https://app.example.com / https://api.example.com (no trailing slash)
#
# URL the browser uses to reach the API. Baked into the UI at BUILD time:
# after changing it run `docker compose build --no-cache af-frontend`.
VITE_API_URL=http://localhost:3000
# Must exactly match the UI origin in the browser address bar (CORS)
ALLOWED_ORIGINS=http://localhost:8080
# Public API URL used to build webhook trigger URLs
WEBHOOK_PUBLIC_BASE_URL=http://localhost:3000

# --- Secrets -----------------------------------------------------------------
# openssl rand -hex 32
JWT_SECRET=change-me-in-production
# openssl rand -hex 16 (32 chars). NEVER change after data is stored:
# encrypted credentials become unreadable. Keep a backup copy.
ENCRYPTION_KEY=change-me-in-production-32bytes

# --- Admin user (applied on first start only) --------------------------------
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme123
ADMIN_NAME=Admin

# --- Database ----------------------------------------------------------------
# Local MongoDB container: keep default and start with `--profile with-db`
# Atlas: mongodb+srv://... and start without the profile
MONGODB_URI=mongodb://mongo:27017/agent-factory
# Optional auth for the local MongoDB container
MONGO_USER=
MONGO_PASSWORD=

# =============================================================================
# 2. DEPLOYMENT - usually fine as is
# =============================================================================

# Git branch/tag to build
API_VERSION=master
UI_VERSION=master

NODE_ENV=production

# Host ports. Behind a reverse proxy (Caddy/Nginx) bind to localhost only:
#   API_PORT=127.0.0.1:3000  UI_PORT=127.0.0.1:8080  MONGO_PORT=127.0.0.1:27017
API_PORT=3000
UI_PORT=8080
MONGO_PORT=27017

VITE_APP_NAME=Agent Factory

# =============================================================================
# 3. TUNING - optional, defaults are fine
# =============================================================================

# Agents & engine
# Max saved snapshots per agent
AGENT_MAX_SNAPSHOTS=50
# Default number of workflow nodes executed in parallel
ENGINE_DEFAULT_PARALLEL_NODES=2

# LLM
# Hard limit on tool calls per LLM invocation
# LLM_MAX_TOOL_CALLS=10
# How long a run waits for the client (UI) to answer a client tool call (ms)
LLM_CLIENT_TOOL_TIMEOUT_MS=60000

# Agent scheduler
# Max delay between checks for due schedules (ms)
SCHEDULER_POLL_INTERVAL_MS=15000
# Max scheduled runs executing at the same time
SCHEDULER_MAX_CONCURRENT_RUNS=3

# Webhooks
# Max webhook request body size (bytes) and triggers per webhook per minute
WEBHOOK_MAX_BODY_BYTES=1048576
WEBHOOK_RATE_LIMIT_PER_MINUTE=60
# Custom webhook handler limits
WEBHOOK_HANDLER_TIMEOUT_MS=1000
WEBHOOK_HANDLER_MEMORY_MB=32
# Max time `await ctx.runAgent()` in a handler waits for the agent (ms)
WEBHOOK_RUN_WAIT_TIMEOUT_MS=30000
