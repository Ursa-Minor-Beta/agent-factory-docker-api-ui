# Version/branch to deploy
API_VERSION=master
UI_VERSION=master

# Ports
API_PORT=3000
UI_PORT=8080
MONGO_PORT=27017

# Admin user
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme123
ADMIN_NAME=Admin

# API Configuration
NODE_ENV=production
JWT_SECRET=change-me-in-production
ENCRYPTION_KEY=change-me-in-production-32bytes

# MongoDB authentication (optional, for local MongoDB)
MONGO_USER=
MONGO_PASSWORD=
MONGODB_URI=mongodb://mongo:27017/agent-factory

# UI Configuration
VITE_API_URL=http://localhost:3000
VITE_APP_NAME=Agent Factory
