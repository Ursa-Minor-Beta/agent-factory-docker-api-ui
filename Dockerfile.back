# syntax=docker/dockerfile:1
FROM node:26-alpine AS src

ARG API_VERSION

# Fetch the repository (re-fetched only when the ref points to a new commit)
ADD https://github.com/Ursa-Minor-Beta/agent-factory.git#${API_VERSION} /src

FROM node:26-alpine AS builder

WORKDIR /app

# Install dependencies (cached until package*.json changes)
COPY --from=src /src/package*.json ./
RUN --mount=type=cache,target=/root/.npm npm ci

COPY --from=src /src ./
RUN npm run build

# Production stage
FROM node:26-alpine AS runner

WORKDIR /app

COPY --from=src /src/package*.json ./
RUN --mount=type=cache,target=/root/.npm npm ci --omit=dev

COPY --from=builder /app/dist ./dist

ENV NODE_ENV=production

EXPOSE 3000

CMD ["node", "dist/index.js"]
